# Скопируйте в .env и подставьте свои значения.
# Секретов в репозитории нет и быть не должно.

# --- приложение ---
APP_NAME=OrderFlow Scale
DEBUG=false
LOG_LEVEL=INFO
LOG_JSON=true
CORS_ORIGINS=["http://localhost:3000"]

# --- база данных ---
DATABASE_URL=postgresql+asyncpg://orderflow:orderflow@localhost:5432/orderflow

# --- auth (сгенерируйте: python -c "import secrets; print(secrets.token_urlsafe(48))") ---
SECRET_KEY=change-me-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=30

# --- кэш (cache-aside) ---
# memory — в разработке и тестах; redis — в проде
CACHE_BACKEND=memory
REDIS_URL=redis://localhost:6379/0
CACHE_TTL_SECONDS=60
# Бамп версии инвалидирует ВСЕ ключи каталога без перебора
CACHE_VERSION=v1

# --- rate limiting (sliding window) ---
RATE_LIMIT_BACKEND=memory
RATE_LIMIT_REQUESTS=60
RATE_LIMIT_WINDOW_SECONDS=60

# --- uvicorn ---
UVICORN_WORKERS=4

# --- grafana (docker-compose) ---
GRAFANA_PASSWORD=admin
